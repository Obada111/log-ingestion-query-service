# Runtime configuration — every variable has a safe default.
# Copy to .env or set in the environment. docker compose up needs nothing.

PORT=8080
DATABASE_URL=postgres://loguser:logpass@localhost:5432/logdb
PG_POOL_MAX=10
# Dedicated writer pool — ingestion never queues behind slow queries.
PG_WRITE_POOL_MAX=2
LOG_LEVEL=info

# Retention: delete logs older than this many hours (default 31 days).
RETENTION_HOURS=744
# How often the retention sweeper wakes up (ms).
RETENTION_SWEEP_INTERVAL_MS=900000

# Ingestion coalescing writer knobs (see study/07-ingestion.md).
INGEST_MAX_FLUSH_WAIT_MS=10
INGEST_MAX_ROWS_PER_FLUSH=2000

# Optional authentication. OFF by default. See implementation README.
AUTH_ENABLED=false
LOADGEN_API_KEY=
